# Set SECRET_KEY in your terminal or hosting platform (not committed to Git).
# Example: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-strong-random-secret
# Optional: absolute path to existing SQLite database
# DATABASE=C:/path/to/applications.db
# Set to 1 when running behind HTTPS on a hosted server
COOKIE_SECURE=0
